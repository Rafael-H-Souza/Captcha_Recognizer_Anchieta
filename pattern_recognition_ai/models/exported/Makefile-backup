# Makefile para automação de setup, treino e inferência (Ubuntu/Linux)
# -----------------------------------------------------------------------------

VENV_DIR=venv
PYTHON_BIN := python3
PYTHON_BIN=$(VENV_DIR)/bin/python
PIP_BIN=$(VENV_DIR)/bin/pip

# Número de épocas de treinamento do modelo
EPOCHS ?= 120
# Tamanho do batch de imagens por iteração
BATCH_SIZE ?= 32
# Quantidade total de imagens no dataset
NUM_IMAGES ?= 50000
# Acurácia alvo para considerar o treino satisfatório
TARGET_ACCURACY ?= 0.95
# Prazo final para finalizar o treino ou avaliação
DEADLINE ?= 2025-11-14
# Caminho da imagem de teste ou exemplo
IMAGE_PATH ?= five_char_alphanumeric_case_1.png

LOG_DIR=logs

# Detecta número de cores do CPU
NCORES := $(shell nproc)
HALFCORES := $(shell expr $(NCORES) / 2)

# -----------------------------------------------------------------------------  
.PHONY: setup install train train-gpu train-parallel train-max train-half \
        evaluate infer clean freeze all report dataset preprocess report-data \
        interface merge-models show-model generate-images train-parallel-live

all: setup freeze


# -----------------------------------------------------------------------------
# 📦 Setup e Instalação
# -----------------------------------------------------------------------------
setup:
	@echo "🔧 Criando ambiente virtual em '$(VENV_DIR)'..."
	python3.10 -m venv $(VENV_DIR)
	@echo "✅ Ambiente criado em $(VENV_DIR)."
	@$(MAKE) install

install:
	@echo "📦 Instalando dependências do 'requirements.txt'..."
	$(PIP_BIN) install --upgrade pip
	$(PIP_BIN) install -r requirements.txt
	@echo "✅ Dependências instaladas com sucesso."


# -----------------------------------------------------------------------------
# 🚀 Treinamento normal
# -----------------------------------------------------------------------------
train:
	@mkdir -p $(LOG_DIR)
	@echo "🚀 Iniciando treinamento do modelo (CPU)..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py --epochs $(EPOCHS) --batch-size $(BATCH_SIZE)
	@echo "✅ Treinamento concluído. Executando avaliação pós-treino..."
	$(MAKE) evaluate


# -----------------------------------------------------------------------------
# ⚡ Treinamento em paralelo (em background)
# -----------------------------------------------------------------------------
train-parallel:
	@mkdir -p $(LOG_DIR)
	@echo "⚡ Iniciando TREINO PARALELO (CPU Turbo)..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py --epochs $(EPOCHS) --batch-size $(BATCH_SIZE) > logs/train_parallel.log 2>&1 &
	@echo "🔥 Treino paralelo rodando em background! (logs/train_parallel.log)"

train-parallel-live:
	@echo "⚡ Iniciando treino paralelo (LIVE)..."
	(PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py --epochs $(EPOCHS) --batch-size $(BATCH_SIZE)) &


# -----------------------------------------------------------------------------
# 🔥 Treino usando TODOS os núcleos da CPU
# -----------------------------------------------------------------------------
train-max:
	@mkdir -p $(LOG_DIR)
	@echo "🔥 Iniciando treino com TODOS os núcleos da CPU ($(NCORES) cores)..."
	taskset -c 0-$(shell expr $(NCORES) - 1) PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py --epochs $(EPOCHS) --batch-size $(BATCH_SIZE) > logs/train_max.log 2>&1 &
	@echo "🚀 Treino MAX rodando! Log: logs/train_max.log"




# -----------------------------------------------------------------------------
# 🟦 Treino usando metade dos núcleos da CPU
# -----------------------------------------------------------------------------
train-half:
	@mkdir -p $(LOG_DIR)
	@echo "🟦 Iniciando treino com METADE dos núcleos da CPU ($(HALFCORES) cores)..."
	taskset -c 0-$(shell expr $(HALFCORES) - 1) PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py --epochs $(EPOCHS) --batch-size $(BATCH_SIZE) > logs/train_half.log 2>&1 &
	@echo "🟪 Treino HALF rodando! Log: logs/train_half.log"


# -----------------------------------------------------------------------------
# 🟦 Treino GPU normal (sincrono)
# -----------------------------------------------------------------------------

train-gpu:
	@mkdir -p $(LOG_DIR)
	@echo "🚀 Iniciando treinamento (GPU)..."
	USE_GPU=true PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py \
		--epochs $(EPOCHS) --batch-size $(BATCH_SIZE) --use-gpu
	@echo "✅ Treinamento GPU concluído. Executando avaliação..."
	$(MAKE) evaluate


# -----------------------------------------------------------------------------
# 🟦 Treino GPU em paralelo (background)
# -----------------------------------------------------------------------------

train-gpu-parallel:
	@mkdir -p $(LOG_DIR)
	@echo "⚡ Iniciando treino (GPU) em segundo plano..."
	USE_GPU=true PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train.py \
		--epochs $(EPOCHS) --batch-size $(BATCH_SIZE) --use-gpu \
		> logs/train_gpu_parallel.log 2>&1 &
	@echo "🔥 Treino GPU em background! Log: logs/train_gpu_parallel.log"

# -----------------------------------------------------------------------------
# 🟦 Treino TURBO GPU (XLA + mixed precision + otimizações)
# -----------------------------------------------------------------------------


train-gpu-turbo:
	@mkdir -p $(LOG_DIR)
	@echo "🚀 Iniciando treino TURBO (GPU + XLA + Mixed Precision)..."
	TF_XLA_FLAGS="--tf_xla_auto_jit=2" \
	MIXED_PRECISION=true USE_GPU=true \
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/train_turbo.py \
		--epochs $(EPOCHS) --batch-size $(BATCH_SIZE) \
		> logs/train_gpu_turbo.log 2>&1
	@echo "🔥 Treino TURBO concluído! Log: logs/train_gpu_turbo.log"


# -----------------------------------------------------------------------------
# 📦 Avaliação e exportação
# -----------------------------------------------------------------------------
evaluate:
	@echo "📦 Exportando todos os modelos..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/export_all_models.py
	@echo "📊 Avaliando modelos exportados..."
	@if PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/evaluate.py; then \
		echo "✅ Avaliação concluída com sucesso."; \
	else \
		echo "❌ Erro durante a avaliação. Verifique os logs."; \
	fi


# -----------------------------------------------------------------------------
# 🔍 Debug e ferramentas adicionais
# -----------------------------------------------------------------------------
show-model:
	@echo "🚀 Mostrando modelos..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/show_models.py

infer:
	@echo "🧠 Executando inferência..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/infer.py --image_path $(IMAGE_PATH)
	@echo "✅ Inferência concluída."

dataset:
	@echo "🗂️ Gerando dataset sintético..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/generate_dataset.py --num-images $(NUM_IMAGES)

generate-images:
	@echo "🖼️ Gerando imagens pré-processadas..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/generate_preprocessed_images.py

preprocess:
	@echo "🧼 Pré-processando imagens..."
	PYTHONPATH=$(CURDIR) $(PYTHON_BIN) scripts/prepare_data.py

interface:
	@echo "🧠 Executando interface..."
	. venv/bin/activate && streamlit run app_interfacev2.py

merge-models:
	@echo "🔀 Mesclando modelos..."
	$(PYTHON_BIN) merge_models.py
	@echo "✅ Modelos mesclados com sucesso."


# -----------------------------------------------------------------------------
# 🧹 Limpeza
# -----------------------------------------------------------------------------
clean:
	@echo "🧹 Limpando projeto..."
	rm -rf $(shell find . -name __pycache__)
	rm -rf .pytest_cache/
	rm -rf logs/*
	rm -rf models/checkpoints/*
	@echo "✅ Limpeza finalizada."

freeze:
	@echo "🧊 Exportando dependências atualizadas..."
	$(PIP_BIN) freeze > requirements.txt
	@echo "✅ requirements.txt atualizado."
